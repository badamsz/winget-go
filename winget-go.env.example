# winget-go settings file
#
# winget-go loads every file named "winget-go.env" it finds, in this order of
# precedence (highest first):
#   1. <user config dir>/winget-go/winget-go.env
#        Windows: %APPDATA%\winget-go\winget-go.env
#        macOS:   ~/Library/Application Support/winget-go/winget-go.env
#        Linux:   ~/.config/winget-go/winget-go.env
#   2. Machine-wide: %ProgramData%\winget-go\winget-go.env  (or /etc/winget-go/winget-go.env)
#   3. Next to the winget-go executable
# Set WINGET_GO_ENV_FILE=<path> to use exactly one file instead.
#
# Real environment variables always win over these files, except the list
# settings WINGET_GO_EXCLUDE and WINGET_GO_EXCLUDE_FILE, which are combined
# from every source. Only WINGET_GO_*, GITHUB_TOKEN and GH_TOKEN are accepted.
# Run `winget-go --backend portable --info` to see which files were loaded.

# --- Exclusions --------------------------------------------------------------
# Packages that `upgrade`, `list --upgrade-available` and `import` skip.
# Case-insensitive globs on the package Id; prefix with "name:" to match the
# display name instead. Separate with commas, semicolons or new lines.
# Use --no-exclude on a single run to ignore all exclusions.
WINGET_GO_EXCLUDE="
  # Browsers update themselves
  Google.Chrome*
  Microsoft.Edge*
  Mozilla.Firefox*

  # Managed by the IT department
  Microsoft.Office
  name:Visual Studio *
"

# Additional plain-text exclusion files (one pattern per line, # comments).
# Separate several paths with ';' on Windows or ':' elsewhere.
#WINGET_GO_EXCLUDE_FILE=C:\ProgramData\winget-go\exclusions.txt

# --- Other settings ----------------------------------------------------------
#WINGET_GO_BACKEND=auto            # auto | native | portable
#WINGET_GO_GITHUB=1                # use newer GitHub releases by default
#WINGET_GO_AUTOUPDATE_MINUTES=15   # source refresh interval (0 = never)
#WINGET_GO_LOCALE=en-US
#GITHUB_TOKEN=
